# Copying this file alone is not enough. Run: python3 scripts/dev.py init
# The command generates unique values in ignored .env and never overwrites it.
DJANGO_SECRET_KEY=
INTEGRATION_ENCRYPTION_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_ENGINE=sqlite
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional Docker/MySQL. init also generates unique database passwords.
MYSQL_DATABASE=commerce_warehouse
MYSQL_USER=commerce
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
FRONTEND_BIND=127.0.0.1:8080

# Optional integrations; all disabled/unconfigured initially.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
LARK_CLI_BIN=lark-cli
FEISHU_OAUTH_REDIRECT_URI=
FEISHU_ALLOWED_TENANT_KEYS=
FEISHU_OAUTH_SCOPES=
